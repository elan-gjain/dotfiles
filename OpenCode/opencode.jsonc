{
  "$schema": "https://opencode.ai/config.json",
  "shell": "powershell",
  "mcp": {
    "repomix": {
      "type": "local",
      "enabled": true,
      "timeout": 30000,
      "command": [
        "C:\\Users\\gjain\\AppData\\Roaming\\uv\\tools\\repomix\\Scripts\\python.exe",
        "-u",
        "-m",
        "repomix",
        "--mcp"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "csharp-assistant": {
      "type": "local",
      "command": [
        "roslyn-mcp"
      ],
      "enabled": true
    }
  },
  "model": "openai/gpt-6-luna"
}